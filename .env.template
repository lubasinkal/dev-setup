# Environment Variables Template
# Copy this file to .env and customize for your environment

# ================
#  Development Paths
# ================
DEV_ROOT=%USERPROFILE%\dev
PERSONAL_DEV=%DEV_ROOT%\personal
WORK_DEV=%DEV_ROOT%\work
OPEN_SOURCE_DEV=%DEV_ROOT%\open-source

# ================
#  Editor Configuration
# ================
EDITOR=nvim
GIT_EDITOR=code --wait
BROWSER=chrome

# ================
#  Tool Configurations
# ================
STARSHIP_CONFIG=%USERPROFILE%\.config\starship\starship.toml
YAZI_CONFIG_HOME=%USERPROFILE%\.config\yazi

# ================
#  API Keys (Replace with your actual keys)
# ================
# GITHUB_TOKEN=your_github_token_here
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here

# ================
#  Database Connections
# ================
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# REDIS_URL=redis://localhost:6379

# ================
#  Cloud Provider Credentials
# ================
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_DEFAULT_REGION=us-east-1

# AZURE_SUBSCRIPTION_ID=your_azure_subscription_id
# AZURE_CLIENT_ID=your_azure_client_id
# AZURE_CLIENT_SECRET=your_azure_client_secret

# GOOGLE_APPLICATION_CREDENTIALS=%USERPROFILE%\.config\gcloud\service-account.json

# ================
#  Development Tool Settings
# ================
# NODE_ENV=development
# RUST_LOG=debug
# RUST_BACKTRACE=1

# ================
#  Custom Variables
# ================
# Add your own environment variables here
# MY_CUSTOM_VAR=some_value