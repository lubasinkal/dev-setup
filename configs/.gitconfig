# ~/.gitconfig - Enhanced Git Configuration

# ================
#  User Identity
# ================
[user]
    name = lubasinkal
    email = lubasinkal@outlook.com
    # Sign commits with GPG (uncomment if you have a GPG key)
    # signingKey = YOUR_KEY_ID

# ================
#  Core Settings
# ================
[core]
    editor = code --wait
    pager = delta
    autocrlf = true
    sshCommand = C:/Windows/System32/OpenSSH/ssh.exe
    fsmonitor = true
    # Exclude patterns (like .DS_Store)
    excludesfile = ~/.gitignore_global

# ================
#  UI Enhancements
# ================
[color]
    ui = auto
    branch = auto
    diff = auto
    interactive = auto
    status = auto

[delta]
    navigate = true
    line-numbers = true
    side-by-side = true
    dark = true
    # Custom syntax themes (requires delta 0.12+)
    # features = unobtrusive-line-numbers decorations
    # decorations = commit-decoration file-decoration

[interactive]
    diffFilter = delta --color-only

# ================
#  Branch & Merge
# ================
[init]
    defaultBranch = main

[pull]
    ff = only  # Prefer fast-forward merges when possible
    rebase = merges  # Rebase local commits but preserve merge commits

[push]
    autoSetupRemote = true
    default = current  # Push current branch by default

[merge]
    conflictstyle = zdiff3
    tool = vscode
    stat = true

[mergetool "vscode"]
    cmd = code --wait $MERGED

[rebase]
    autoStash = true  # Automatically stash changes before rebasing
    autoSquash = true  # Automatically squash fixup commits

# ================
#  Aliases (Power User)
# ================
[alias]
    # Basic shortcuts
	st = status -sb
	co = checkout
	br = branch
    ci = commit
	cm = commit -m
    amend = commit --amend --no-edit
    unstage = restore --staged
    discard = checkout --
    
    # Enhanced logging
    lg = log --graph --pretty=format:'%C(yellow)%h%Creset -%C(auto)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
	ll = log --oneline --decorate
    hist = log --pretty=format:'%C(yellow)%h%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --topo-order
	last = log -1 HEAD --stat
    
    # Branch operations
    bclean = "!f() { git branch --merged ${1-main} | grep -v \" ${1-main}$\" | xargs -r git branch -d; }; f"
    bsync = "!f() { git fetch origin ${1-main}:${1-main} --update-head-ok; }; f"
    
    # Working with remotes
	up = pull --rebase
    sync = !git pull --rebase && git push
    publish = !git push -u origin $(git branch --show-current)
    unpublish = !git push origin :$(git branch --show-current)
    
    # Diff enhancements
    d = diff --color-words
    dc = diff --cached
    dw = diff --word-diff
    ds = diff --stat
    
    # Stash shortcuts
    sl = stash list --pretty=format:'%C(yellow)%gd%Creset %C(blue)(%cr)%Creset %s'
    sa = stash apply
    sp = stash pop
    
    # Maintenance
    cleanup = "!git gc --prune=now --aggressive"
    fixup = "!f() { git commit --fixup=$1 && git rebase -i --autosquash $1~; }; f"
    
    # Advanced
    reword = "!f() { git commit --amend --message=\"$1\"; }; f"
    standup = !git log --since yesterday --oneline --author=\"$(git config user.email)\" --color
    whois = "!f() { git log -i -1 --pretty=\"format:%an <%ae>%n%ad%n%s\" --author=\"$1\"; }; f"

# ================
#  Credentials
# ================
[credential]
    # helper = manager
    # For Linux/Mac:
    # helper = cache --timeout=3600
    # For Windows:
    helper = wincred

# ================
#  Miscellaneous
# ================
[rerere]
    enabled = true
    autoUpdate = true

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

[http]
    postBuffer = 524288000
    # For faster clones in some cases
    lowSpeedLimit = 0
    lowSpeedTime = 999999
	sslVerify = false

[grep]
    lineNumber = true
    extendRegexp = true

[commit]
    template = ~/.gitmessage.txt
    verbose = true

[tag]
    forceSignAnnotated = true

[blame]
    date = short
[credential "helperselector"]
	selected = wincred
